# StreamVLN x86 服务端配置
# 用法: source config/server.env && ./scripts/run_server.sh

# 模型 checkpoint（真机部署专用权重）
MODEL_PATH="${RGB_WS_ROOT}/checkpoints/StreamVLN_Video_qwen_1_5_r2r_rxr_envdrop_scalevln_real_world"
MODEL_HF_ID="mengwei0427/StreamVLN_Video_qwen_1_5_r2r_rxr_envdrop_scalevln_real_world"

# 服务
HOST="0.0.0.0"
PORT=5801
DEVICE="cuda:0"

# 默认导航指令（Go2 客户端可在 JSON 里覆盖）
DEFAULT_INSTRUCTION="Walk forward and stop when you reach the doorway."

# StreamVLN 推理参数（与官方 realworld 一致）
NUM_FUTURE_STEPS=4
NUM_FRAMES=32
NUM_HISTORY=8
MODEL_MAX_LENGTH=4096
