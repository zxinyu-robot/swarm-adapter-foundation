# 本机仿真专用（source 后 run_sim_bench.sh）
# 与真狗联调 config/edge.env 分离，避免 directive 发到真狗

LISTEN_HOST="127.0.0.1"
SUBGRAPH_PORT=9877
RGB_PORT=9878
DIRECTIVE_PORT=9879

GO2_HOST="127.0.0.1"
GO2_DIRECTIVE_PORT=9879

SESSION_ID="sim_local"
INSTRUCTION="sim_bench_directive"
AUTO_DIRECTIVE=true
STATUS_INTERVAL_S=0
SCHEDULER="layer_fusion_stub"
ALIGN_WAIT_S=0.5
STREAMVLN_PORT=5801
STREAMVLN_URL="http://127.0.0.1:5801/eval_vln"
# 仿真 qwen_vl 默认 stub（无 GPU）；真 GPU 评测：QWEN_VL_STUB=false ./scripts/run_sim_bench.sh --scheduler qwen_vl
QWEN_VL_STUB="true"
QWEN_VL_MODEL="Qwen/Qwen2.5-VL-3B-Instruct"
QWEN_VL_DEVICE="cuda:0"
QWEN_VL_4BIT="true"
