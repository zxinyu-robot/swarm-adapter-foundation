# v1 边侧网关配置（source 后运行 scripts/run_edge_server.sh）

LISTEN_HOST="0.0.0.0"
SUBGRAPH_PORT=9877
RGB_PORT=9878

# Go2 directive_receiver 监听地址
GO2_HOST="192.0.2.61"
GO2_DIRECTIVE_PORT=9879

SESSION_ID="demo_live"
INSTRUCTION="找厨房"
AUTO_DIRECTIVE=true
STATUS_INTERVAL_S=30

# 边侧语义调度：mock | geom_baseline | layer_fusion_stub | streamvln | qwen_vl
SCHEDULER="qwen_vl"

# Qwen2.5-VL-3B（scheduler=qwen_vl，默认轻量）
QWEN_VL_MODEL="Qwen/Qwen2.5-VL-3B-Instruct"
QWEN_VL_DEVICE="cuda:0"
QWEN_VL_4BIT="true"
QWEN_VL_MAX_TOKENS=512
QWEN_VL_MIN_INTERVAL_S=0.5
# 无 GPU 或仅测协议时设为 true（CPU 规则 stub，不加载模型）
QWEN_VL_STUB="false"

# StreamVLN 支路（scheduler=streamvln 时）
STREAMVLN_URL="http://127.0.0.1:5801/eval_vln"

# L0/L1/L2 对齐等待（秒）
ALIGN_WAIT_S=0.5
